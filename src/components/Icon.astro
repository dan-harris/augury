---
interface Props {
  name: "dice" | "chair" | string;
  class?: string;
  [key: string]: any;
}

const { name, class: className = "size-5 inline-block", ...rest } = Astro.props;
---

<svg class={className} aria-hidden="true" {...rest}>
  <use href={`/icons/spritesheet.svg#icon-${name}`}></use>
</svg>
