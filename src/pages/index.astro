---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Augury — D&D Session Scheduler & Character Ledger">
	<main class="max-w-[850px] mx-auto">
		<div
			class="page-container page-container-inner border-2 border-ink-primary p-6 sm:p-12 relative"
		>
			<header class="mb-10 text-center">
				<div class="flex items-center justify-center gap-1 mb-3">
					<img
						src="/logo-hourglass.png"
						alt="Augury Logo"
						class="h-20 mix-blend-multiply"
						onerror="this.style.display = 'none'"
					/>
					<h1
						class="font-gothic text-6xl sm:text-8xl text-ink-primary m-0 leading-none mb-2"
					>
						Augury
					</h1>
				</div>
				<div
					class="font-label uppercase tracking-[4px] opacity-80 text-sm sm:text-base"
				>
					TTRPG Session Scheduler
				</div>
			</header>

			<section class="text-center max-w-2xl mx-auto flex flex-col gap-10">
				<p class="font-serif text-xl leading-relaxed text-ink-primary">
					Coordinate campaign sessions without the endless quest for
					consensus. Gather candidate days, tally player availability,
					and lock in confirmed dates with an archaic, reliable
					ledger.
				</p>

				<div class="flex flex-col items-center gap-4">
					<a
						href="/admin"
						class="btn-frame inline-block p-4 bg-ink-primary text-parchment-base border-2 border-ink-primary font-label uppercase tracking-[2px] font-bold text-lg text-center hover:bg-parchment-secondary hover:text-ink-primary transition-colors shadow-sm"
					>
						Open Admin Dashboard
					</a>
				</div>
			</section>
		</div>
	</main>
</Layout>
