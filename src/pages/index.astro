---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Augury — augury.danharris.dev">
	<main class="relative min-h-screen px-4 py-16 sm:px-8 sm:py-24 max-w-6xl mx-auto flex flex-col justify-between">
		<!-- Background Glow Effects -->
		<div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
		<div class="absolute bottom-1/3 left-1/3 w-80 h-80 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>

		<header class="w-full flex justify-between items-center pb-8 border-b border-gray-800/80">
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/25">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
					</svg>
				</div>
				<span class="font-heading text-xl font-bold tracking-tight text-white">Augury</span>
			</div>
			<div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium">
				<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
				Cloudflare Pages Ready
			</div>
		</header>

		<section class="py-16 sm:py-24 text-center max-w-3xl mx-auto relative z-10">
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gray-800/80 border border-gray-700/60 text-indigo-300 text-xs font-medium mb-8 backdrop-blur-sm">
				<span>augury.danharris.dev</span>
			</div>

			<h1 class="font-heading text-4xl sm:text-6xl font-extrabold text-white tracking-tight mb-6 leading-tight">
				Predictive Insights & Intelligence Engine
			</h1>

			<p class="text-base sm:text-xl text-gray-400 font-normal leading-relaxed mb-10 max-w-2xl mx-auto">
				Base Astro v7 application configured for Cloudflare Pages adapter with SSR server rendering, Tailwind CSS v4, and Oxlint setup.
			</p>

			<div class="flex flex-wrap justify-center gap-4">
				<a href="https://astro.build" target="_blank" rel="noopener noreferrer" id="docs-button" class="px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-semibold text-sm hover:opacity-95 transition-all shadow-lg shadow-indigo-500/20">
					Explore Astro Docs
				</a>
				<a href="https://developers.cloudflare.com/pages/" target="_blank" rel="noopener noreferrer" id="cloudflare-button" class="px-6 py-3 rounded-xl bg-gray-800/80 hover:bg-gray-800 border border-gray-700/80 text-gray-200 font-semibold text-sm transition-all backdrop-blur-sm">
					Cloudflare Pages Setup
				</a>
			</div>
		</section>

		<section class="grid grid-cols-1 md:grid-cols-3 gap-6 my-8 relative z-10">
			<div class="p-6 rounded-2xl bg-gray-900/60 border border-gray-800/80 backdrop-blur-sm hover:border-gray-700/80 transition-all">
				<div class="w-10 h-10 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
				</div>
				<h3 class="font-heading text-lg font-semibold text-white mb-2">Cloudflare Adapter</h3>
				<p class="text-sm text-gray-400 leading-relaxed">
					Pre-configured with <code class="text-indigo-300 font-mono text-xs">@astrojs/cloudflare</code> for edge rendering and server side execution.
				</p>
			</div>

			<div class="p-6 rounded-2xl bg-gray-900/60 border border-gray-800/80 backdrop-blur-sm hover:border-gray-700/80 transition-all">
				<div class="w-10 h-10 rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
				</div>
				<h3 class="font-heading text-lg font-semibold text-white mb-2">Tailwind CSS v4</h3>
				<p class="text-sm text-gray-400 leading-relaxed">
					Modern utility-first styling with <code class="text-purple-300 font-mono text-xs">@tailwindcss/vite</code> integration out of the box.
				</p>
			</div>

			<div class="p-6 rounded-2xl bg-gray-900/60 border border-gray-800/80 backdrop-blur-sm hover:border-gray-700/80 transition-all">
				<div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
				</div>
				<h3 class="font-heading text-lg font-semibold text-white mb-2">Ox Tooling</h3>
				<p class="text-sm text-gray-400 leading-relaxed">
					High speed linting & formatting powered by <code class="text-emerald-300 font-mono text-xs">oxlint</code> and <code class="text-emerald-300 font-mono text-xs">oxfmt</code>.
				</p>
			</div>
		</section>

		<footer class="pt-8 border-t border-gray-800/80 text-center text-xs text-gray-500">
			<p>© {new Date().getFullYear()} Augury • augury.danharris.dev</p>
		</footer>
	</main>
</Layout>
