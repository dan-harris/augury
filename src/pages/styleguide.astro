---
import Checkbox from "../components/Checkbox.astro";
import Icon from "../components/Icon.astro";
import Input from "../components/Input.astro";
import Radio from "../components/Radio.astro";
import RadioGroup from "../components/RadioGroup.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Augury Styleguide — Character Ledger"
	description="Design tokens, typography, and character ledger components for Augury."
>
	<div
		class="min-h-screen text-ink-primary font-serif leading-relaxed px-4 py-12 text-lg"
	>
		<!-- SVG Filters -->
		<svg width="0" height="0" class="absolute -z-10">
			<filter
				id="print-texture"
				x="-10%"
				y="-10%"
				width="120%"
				height="120%"
			>
				<feTurbulence
					type="fractalNoise"
					baseFrequency="0.6"
					numOctaves="1"
					result="noise"></feTurbulence>
				<feDisplacementMap
					in="SourceGraphic"
					in2="noise"
					scale="1.0"
					xChannelSelector="R"
					yChannelSelector="G"></feDisplacementMap>
			</filter>
		</svg>

		<div
			class="border-page max-w-[850px] mx-auto border-2 border-ink-primary p-6 sm:p-12 relative bg-parchment-base"
		>
			<header class="mb-10">
				<div class="flex items-center justify-center gap-6 mb-2">
					<img
						src="/logo-hourglass.png"
						alt="Augury Logo"
						class="h-20 mix-blend-multiply"
						onerror="this.style.display = 'none'"
					/>
					<h1
						class="font-gothic text-7xl sm:text-8xl text-center text-ink-primary m-0 leading-none drop-shadow-sm"
					>
						Augury
					</h1>
				</div>
				<div
					class="text-center font-label uppercase tracking-[4px] opacity-80 text-sm"
				>
					Character Ledger Styleguide
				</div>
			</header>

			<main>
				<div class="grid grid-cols-1 md:grid-cols-[3fr_2fr] gap-8 mt-8">
					<!-- Left Column: Details -->
					<div class="flex flex-col gap-8">
						<!-- Identity Block -->
						<section class="relative">
							<SectionHeading title="Identity" />

							<div class="p-6 flex flex-col gap-6">
								<div class="flex items-end">
									<label
										class="font-label font-bold uppercase text-lg mr-3 leading-tight w-20 shrink-0"
										>Name</label
									>
									<Input
										type="text"
										class="flex-1 font-serif text-2xl px-2 rounded-none"
										placeholder="Silas the Unyielding"
									/>
								</div>

								<div class="flex items-end">
									<label
										class="font-label font-bold uppercase text-lg mr-3 leading-tight w-20 shrink-0"
										>Class</label
									>
									<Input
										type="text"
										class="flex-1 font-serif text-2xl px-2 rounded-none"
										placeholder="The Worker"
									/>
								</div>

								<div
									class="border-2 border-ink-primary p-4 relative rounded-none bg-transparent mt-2"
								>
									<label
										class="absolute -top-3 left-3 bg-parchment-base px-2 font-label font-bold uppercase text-xs tracking-wider"
										>Background & Info</label
									>
									<textarea
										rows="4"
										class="w-full border-none bg-transparent font-serif text-xl text-ink-primary resize-y outline-none"
										placeholder="Write your grim history here..."
									></textarea>
								</div>
							</div>
						</section>

						<!-- Inventory Block -->
						<section
							class="border-3 border-ink-primary bg-parchment-base [box-shadow:3px_3px_0px_rgba(0,0,0,0.12)] relative"
						>
							<div
								class="flex items-center border-b-3 border-ink-primary bg-parchment-base"
							>
								<div
									class="w-14 h-14 border-r-3 border-ink-primary flex items-center justify-center font-gothic text-4xl font-bold leading-none text-ink-primary shrink-0 select-none bg-parchment-base"
								>
									I
								</div>
								<div
									class="px-4 font-gothic text-4xl font-bold text-ink-primary tracking-wide leading-none"
								>
									nventory
								</div>
							</div>
							<div
								class="bg-ink-primary text-parchment-base py-[0.35rem] px-4 font-serif text-[0.95rem] italic font-semibold tracking-wide border-b-2 border-ink-primary"
							>
								3. Gear & Equipment Carried:
							</div>
							<div class="p-6 flex flex-col gap-4">
								<label
									class="font-serif text-xl cursor-pointer flex items-center gap-4"
								>
									<Checkbox />
									Lantern (lit)
								</label>
								<label
									class="font-serif text-xl cursor-pointer flex items-center gap-4"
								>
									<Checkbox checked />
									Rope (50ft)
								</label>
								<label
									class="font-serif text-xl cursor-pointer flex items-center gap-4"
								>
									<Checkbox />
									Iron Rations (3 days)
								</label>
								<label
									class="font-serif text-xl cursor-pointer flex items-center gap-4"
								>
									<Checkbox />
									Tinderbox & Torches
								</label>
							</div>
						</section>
					</div>

					<!-- Right Column: Stats & Status -->
					<div class="flex flex-col gap-8">
						<!-- Stats / Attributes Block -->
						<section
							class="border-3 border-ink-primary bg-parchment-base [box-shadow:3px_3px_0px_rgba(0,0,0,0.12)] relative"
						>
							<div
								class="flex items-center border-b-3 border-ink-primary bg-parchment-base"
							>
								<div
									class="w-14 h-14 border-r-3 border-ink-primary flex items-center justify-center font-gothic text-4xl font-bold leading-none text-ink-primary shrink-0 select-none bg-parchment-base"
								>
									S
								</div>
								<div
									class="px-4 font-gothic text-4xl font-bold text-ink-primary tracking-wide leading-none"
								>
									tats
								</div>
							</div>
							<div
								class="bg-ink-primary text-parchment-base py-[0.35rem] px-4 font-serif text-[0.95rem] italic font-semibold tracking-wide border-b-2 border-ink-primary"
							>
								1. Roll 6d10 each:
							</div>
							<div class="p-6 flex flex-col gap-6">
								<!-- Strength -->
								<div class="flex flex-col items-center gap-2">
									<span
										class="font-label font-bold uppercase tracking-widest text-lg"
										>Strength</span
									>
									<div
										class="relative w-24 h-24 border-2 border-ink-primary flex items-center justify-center bg-transparent"
									>
										<div
											class="absolute top-1 left-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute top-1 right-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute bottom-1 left-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute bottom-1 right-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="w-18 h-18 rounded-full border-2 border-ink-primary flex items-center justify-center"
										>
											<div
												class="w-15 h-15 rounded-full border border-ink-primary flex items-center justify-center font-gothic text-4xl font-bold"
											>
												12
											</div>
										</div>
									</div>
								</div>

								<!-- Intellect -->
								<div class="flex flex-col items-center gap-2">
									<span
										class="font-label font-bold uppercase tracking-widest text-lg"
										>Intellect</span
									>
									<div
										class="relative w-24 h-24 border-2 border-ink-primary flex items-center justify-center bg-transparent"
									>
										<div
											class="absolute top-1 left-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute top-1 right-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute bottom-1 left-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute bottom-1 right-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="w-18 h-18 rounded-full border-2 border-ink-primary flex items-center justify-center"
										>
											<div
												class="w-15 h-15 rounded-full border border-ink-primary flex items-center justify-center font-gothic text-4xl font-bold"
											>
												8
											</div>
										</div>
									</div>
								</div>

								<!-- Will -->
								<div class="flex flex-col items-center gap-2">
									<span
										class="font-label font-bold uppercase tracking-widest text-lg"
										>Will</span
									>
									<div
										class="relative w-24 h-24 border-2 border-ink-primary flex items-center justify-center bg-transparent"
									>
										<div
											class="absolute top-1 left-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute top-1 right-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute bottom-1 left-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="absolute bottom-1 right-1 w-3 h-3 rounded-full border border-ink-primary"
										>
										</div>
										<div
											class="w-18 h-18 rounded-full border-2 border-ink-primary flex items-center justify-center"
										>
											<div
												class="w-15 h-15 rounded-full border border-ink-primary flex items-center justify-center font-gothic text-4xl font-bold"
											>
												14
											</div>
										</div>
									</div>
								</div>
							</div>
						</section>

						<!-- Condition Block -->
						<section
							class="border-3 border-ink-primary bg-parchment-base [box-shadow:3px_3px_0px_rgba(0,0,0,0.12)] relative"
						>
							<div
								class="flex items-center border-b-3 border-ink-primary bg-parchment-base"
							>
								<div
									class="w-14 h-14 border-r-3 border-ink-primary flex items-center justify-center font-gothic text-4xl font-bold leading-none text-ink-primary shrink-0 select-none bg-parchment-base"
								>
									C
								</div>
								<div
									class="px-4 font-gothic text-4xl font-bold text-ink-primary tracking-wide leading-none"
								>
									ondition
								</div>
							</div>
							<div
								class="bg-ink-primary text-parchment-base py-[0.35rem] px-4 font-serif text-[0.95rem] italic font-semibold tracking-wide border-b-2 border-ink-primary"
							>
								4. Health & Physical State:
							</div>
							<div class="p-6 flex flex-col gap-6">
								<div
									class="border-2 border-ink-primary p-4 relative rounded-none bg-transparent"
								>
									<label
										class="absolute -top-3 left-3 bg-parchment-base px-2 font-label font-bold uppercase text-xs tracking-wider"
										>Current Health</label
									>
									<input
										type="text"
										class="w-full border-none bg-transparent font-gothic text-5xl text-center text-ink-primary outline-none"
										value="10 / 10"
									/>
								</div>

								<RadioGroup class="flex flex-col gap-3">
									<label
										class="font-serif text-xl cursor-pointer flex items-center gap-4"
									>
										<Radio name="status" checked />
										Healthy & Hale
									</label>
									<label
										class="font-serif text-xl cursor-pointer flex items-center gap-4"
									>
										<Radio name="status" />
										Severely Wounded
									</label>
									<label
										class="font-serif text-xl cursor-pointer flex items-center gap-4"
									>
										<Radio name="status" />
										Doomed
									</label>
								</RadioGroup>
							</div>
						</section>
					</div>
				</div>

				<!-- SVG Spritesheet Inventory Block -->
				<section
					class="border-3 border-ink-primary bg-parchment-base [box-shadow:3px_3px_0px_rgba(0,0,0,0.12)] relative mt-8"
				>
					<div
						class="flex items-center border-b-3 border-ink-primary bg-parchment-base"
					>
						<div
							class="w-14 h-14 border-r-3 border-ink-primary flex items-center justify-center font-gothic text-4xl font-bold leading-none text-ink-primary shrink-0 select-none bg-parchment-base"
						>
							S
						</div>
						<div
							class="px-4 font-gothic text-4xl font-bold text-ink-primary tracking-wide leading-none"
						>
							pritesheet Icons
						</div>
					</div>
					<div
						class="bg-ink-primary text-parchment-base py-[0.35rem] px-4 font-serif text-[0.95rem] italic font-semibold tracking-wide border-b-2 border-ink-primary"
					>
						SVG Icon Inventory (/icons/spritesheet.svg):
					</div>
					<div class="p-6 grid grid-cols-2 sm:grid-cols-4 gap-6">
						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="dice"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>dice</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="dice" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="chair"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>chair</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="chair" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="spikes"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>spikes</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="spikes" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="scroll"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>scroll</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="scroll" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="swords"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>swords</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="swords" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="info"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>info</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="info" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="chest"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>chest</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="chest" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="cave"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>cave</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="cave" /&gt;</code
							>
						</div>

						<div
							class="border-2 border-ink-primary p-4 flex flex-col items-center justify-center gap-2 bg-parchment-secondary/30 rounded-sm text-center"
						>
							<Icon
								name="castle"
								class="size-10 text-ink-primary"
							/>
							<span
								class="font-label text-xs uppercase tracking-widest font-bold"
								>castle</span
							>
							<code class="text-[10px] opacity-70"
								>&lt;Icon name="castle" /&gt;</code
							>
						</div>
					</div>
				</section>

				<div class="mt-12">
					<button
						class="border-button inline-block w-full p-4 bg-ink-primary text-parchment-base border-2 border-ink-primary font-label uppercase tracking-[2px] font-bold text-2xl cursor-pointer text-center hover:bg-parchment-secondary hover:text-ink-primary transition-colors"
					>
						Commit to the Ledger
					</button>
				</div>
			</main>
		</div>
	</div>
</Layout>
