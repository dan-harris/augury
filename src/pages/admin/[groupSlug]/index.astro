---
import { actions } from "astro:actions";
import Icon from "../../../components/Icon.astro";
import SessionCard from "../../../components/SessionCard.astro";
import Layout from "../../../layouts/Layout.astro";
import { composeSlug, parseSlugId } from "../../../lib/slugs";

export const prerender = false;

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

const groupSlugParam = Astro.params.groupSlug;
const slugId = parseSlugId(groupSlugParam);

if (!slugId || !user) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Action results
const updateResult = Astro.getActionResult(actions.updateGroup);
const addPlayerResult = Astro.getActionResult(actions.addPlayer);
const renamePlayerResult = Astro.getActionResult(actions.renamePlayer);
const removePlayerResult = Astro.getActionResult(actions.removePlayer);
const createInviteResult = Astro.getActionResult(actions.createInvite);
const revokeInviteResult = Astro.getActionResult(actions.revokeInvite);
const removeAdminResult = Astro.getActionResult(actions.removeAdmin);
const confirmSessionResult = Astro.getActionResult(actions.confirmSession);
const closeSessionResult = Astro.getActionResult(actions.closeSession);

// Fetch group
const { data: group } = await supabase
  .from("groups")
  .select("*")
  .eq("slug_id", slugId)
  .maybeSingle();

if (!group) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Verify user is an admin of this group
const { data: adminRecord } = await supabase
  .from("group_admins")
  .select("user_id")
  .eq("group_id", group.id)
  .eq("user_id", user.id)
  .maybeSingle();

if (!adminRecord) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Canonical slug check (301 redirect if stale or bare slugId)
const canonicalSlug = composeSlug(group.name, group.slug_id);
if (groupSlugParam !== canonicalSlug) {
  return Astro.redirect(`/admin/${canonicalSlug}`, 301);
}

// Fetch players, group admins, pending invites
const { data: playersList } = await supabase
  .from("players")
  .select("*")
  .eq("group_id", group.id)
  .order("name", { ascending: true });

const players = playersList || [];

const { data: groupAdminsList } = await supabase
  .from("group_admins")
  .select("user_id")
  .eq("group_id", group.id);

const groupAdmins = groupAdminsList || [];

const { data: invitesList } = await supabase
  .from("admin_invites")
  .select("*")
  .eq("group_id", group.id)
  .order("created_at", { ascending: false });

const invites = invitesList || [];

// Fetch sessions
const { data: sessionsList } = await supabase
  .from("sessions")
  .select("*")
  .eq("group_id", group.id)
  .order("week_start", { ascending: false });

const sessions = sessionsList || [];

// Fetch tallies for all sessions in group
const sessionIds = sessions.map((s) => s.id);
let allTallies: Record<string, any[]> = {};
let voteCounts: Record<string, number> = {};

if (sessionIds.length > 0) {
  const { data: talliesData } = await supabase
    .from("session_day_tallies")
    .select("*")
    .in("session_id", sessionIds);

  if (talliesData) {
    for (const t of talliesData) {
      if (!allTallies[t.session_id]) allTallies[t.session_id] = [];
      allTallies[t.session_id].push({
        day: Number(t.day),
        yes_count: Number(t.yes_count),
        voter_ids: Array.isArray(t.voter_ids) ? t.voter_ids : [],
        viable: Boolean(t.viable),
      });
    }
  }

  const { data: responsesData } = await supabase
    .from("vote_responses")
    .select("session_id, player_id")
    .in("session_id", sessionIds);

  if (responsesData) {
    for (const r of responsesData) {
      voteCounts[r.session_id] = (voteCounts[r.session_id] || 0) + 1;
    }
  }
}

const origin = Astro.url.origin;
const publicGroupUrl = `${origin}/g/${canonicalSlug}`;

// Error messages
const updateError = updateResult?.error?.message || (updateResult?.data && !updateResult.data.success ? updateResult.data.error : null);
const addPlayerError = addPlayerResult?.error?.message || (addPlayerResult?.data && !addPlayerResult.data.success ? addPlayerResult.data.error : null);
const confirmSessionError = confirmSessionResult?.error?.message || (confirmSessionResult?.data && !confirmSessionResult.data.success ? confirmSessionResult.data.error : null);
const closeSessionError = closeSessionResult?.error?.message || (closeSessionResult?.data && !closeSessionResult.data.success ? closeSessionResult.data.error : null);

const renamePlayerError = renamePlayerResult?.error?.message || (renamePlayerResult?.data && !renamePlayerResult.data.success ? renamePlayerResult.data.error : null);
const removePlayerWarning = removePlayerResult?.data && !removePlayerResult.data.success && removePlayerResult.data.requiresConfirmation ? removePlayerResult.data.error : null;
const removePlayerError = removePlayerResult?.error?.message || (removePlayerResult?.data && !removePlayerResult.data.success && !removePlayerResult.data.requiresConfirmation ? removePlayerResult.data.error : null);
const createInviteError = createInviteResult?.error?.message || (createInviteResult?.data && !createInviteResult.data.success ? createInviteResult.data.error : null);
const removeAdminError = removeAdminResult?.error?.message || (removeAdminResult?.data && !removeAdminResult.data.success ? removeAdminResult.data.error : null);
---

<Layout title={`${group.name} — Admin Dashboard`}>
  <main class="max-w-[900px] mx-auto pb-12">
    <div class="page-container page-container-inner border-2 border-ink-primary p-6 sm:p-10 relative">
      <!-- Top Navigation -->
      <nav class="mb-6 flex justify-between items-center border-b border-ink-primary/30 pb-3">
        <a href="/admin" class="font-label text-sm uppercase tracking-wider text-ink-primary hover:underline">
          &larr; Back to Admin Dashboard
        </a>
        <a
          href={publicGroupUrl}
          target="_blank"
          class="btn-frame border-2 border-ink-primary bg-parchment-secondary px-3 py-1 font-label uppercase text-xs tracking-wider text-ink-primary hover:bg-ink-primary hover:text-parchment-base font-bold transition-colors"
        >
          Public Group Shell ↗
        </a>
      </nav>

      <!-- Group Header -->
      <header class="border-b-2 border-ink-primary pb-6 mb-8">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h1 class="font-gothic text-4xl sm:text-5xl text-ink-primary m-0 leading-none">
            {group.name}
          </h1>
          <span class="font-label uppercase tracking-widest text-xs px-2.5 py-1 border border-ink-primary/60 bg-parchment-secondary/60 text-ink-primary font-bold">
            Slug ID: {group.slug_id}
          </span>
        </div>
        <p class="font-serif text-sm text-ink-primary/80 mt-2">
          Viability Threshold: <strong class="font-bold">{group.viability_threshold} players</strong> &bull; Total Roster: <strong class="font-bold">{players.length} players</strong>
        </p>
      </header>

      <!-- Remove Player Confirmation Alert if needed -->
      {removePlayerWarning && (
        <div class="mb-8 p-4 border-2 border-rust-ink bg-rust-paper/40 rounded-md">
          <h3 class="font-label text-lg uppercase tracking-wider text-rust-ink font-bold mb-1 flex items-center gap-2">
            <Icon name="spikes" class="size-5 shrink-0" /> <span>Player Removal Warning</span>
          </h3>
          <p class="font-serif text-sm text-rust-ink mb-3">{removePlayerWarning}</p>
          <div class="flex gap-3">
            <form method="POST" action={actions.removePlayer}>
              <input type="hidden" name="playerId" value={removePlayerResult?.data ? (removePlayerResult as any).data.playerId || "" : ""} />
              <input type="hidden" name="confirmed" value="true" />
              <button
                type="submit"
                class="btn-frame border border-rust-ink bg-rust-ink text-parchment-base px-4 py-1.5 font-label uppercase text-xs tracking-wider font-bold hover:bg-rust-block"
              >
                Confirm Delete & Delete Votes
              </button>
            </form>
            <a href={`/admin/${canonicalSlug}`} class="btn-frame border border-ink-primary bg-parchment-base px-4 py-1.5 font-label uppercase text-xs tracking-wider font-bold">
              Cancel
            </a>
          </div>
        </div>
      )}

      {removePlayerError && (
        <div class="mb-6 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
          <Icon name="spikes" class="size-5 shrink-0" /> <span>{removePlayerError}</span>
        </div>
      )}

      <!-- GRID LAYOUT FOR SECTIONS -->
      <div class="space-y-10">

        <!-- 1. GROUP SETTINGS -->
        <section class="border-2 border-ink-primary p-6 rounded-md bg-parchment-secondary/20">
          <h2 class="font-label text-xl uppercase tracking-widest text-ink-primary border-b border-ink-primary/40 pb-2 mb-4 font-bold flex justify-between items-center">
            <span>⚙ Group Settings</span>
          </h2>

          {updateError && (
            <div class="mb-4 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
              <Icon name="spikes" class="size-5 shrink-0" /> <span>{updateError}</span>
            </div>
          )}

          <div class="grid sm:grid-cols-2 gap-6">
            <!-- Rename Form -->
            <form method="POST" action={actions.updateGroup} class="flex flex-col gap-2">
              <input type="hidden" name="groupId" value={group.id} />
              <label class="font-label uppercase text-xs tracking-wider text-ink-primary/80 font-bold">
                Group Name
              </label>
              <div class="flex gap-2">
                <input
                  type="text"
                  name="name"
                  value={group.name}
                  required
                  class="underline-input flex-1 px-2 py-1 font-serif text-base"
                />
                <button
                  type="submit"
                  class="btn-frame border-2 border-ink-primary bg-ink-primary px-3 py-1 font-label uppercase text-xs tracking-wider text-parchment-base hover:bg-parchment-secondary hover:text-ink-primary font-bold cursor-pointer"
                >
                  Rename
                </button>
              </div>
            </form>

            <!-- Viability Threshold Form -->
            <form method="POST" action={actions.updateGroup} class="flex flex-col gap-2">
              <input type="hidden" name="groupId" value={group.id} />
              <label class="font-label uppercase text-xs tracking-wider text-ink-primary/80 font-bold">
                Viability Threshold (Min Players)
              </label>
              <div class="flex gap-2">
                <input
                  type="number"
                  name="viabilityThreshold"
                  value={group.viability_threshold}
                  min="1"
                  required
                  class="underline-input w-24 px-2 py-1 font-serif text-base"
                />
                <button
                  type="submit"
                  class="btn-frame border-2 border-ink-primary bg-ink-primary px-3 py-1 font-label uppercase text-xs tracking-wider text-parchment-base hover:bg-parchment-secondary hover:text-ink-primary font-bold cursor-pointer"
                >
                  Save Threshold
                </button>
              </div>
            </form>
          </div>
        </section>

        <!-- 2. PLAYER ROSTER -->
        <section class="border-2 border-ink-primary p-6 rounded-md bg-parchment-secondary/20">
          <div class="flex justify-between items-center border-b border-ink-primary/40 pb-2 mb-4">
            <h2 class="font-label text-xl uppercase tracking-widest text-ink-primary font-bold m-0 flex items-center gap-2">
              <Icon name="castle" class="size-6" /> <span>Player Roster ({players.length})</span>
            </h2>
          </div>

          {addPlayerError && (
            <div class="mb-4 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
              <Icon name="spikes" class="size-5 shrink-0" /> <span>{addPlayerError}</span>
            </div>
          )}
          {renamePlayerError && (
            <div class="mb-4 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
              <Icon name="spikes" class="size-5 shrink-0" /> <span>{renamePlayerError}</span>
            </div>
          )}

          <!-- Add Player Form -->
          <form method="POST" action={actions.addPlayer} class="flex gap-3 mb-6">
            <input type="hidden" name="groupId" value={group.id} />
            <input
              type="text"
              name="name"
              required
              placeholder="Enter player name (e.g. Thorin Oakenshield)"
              class="underline-input flex-1 px-3 py-1.5 font-serif text-base"
            />
            <button
              type="submit"
              class="btn-frame border-2 border-ink-primary bg-ink-primary px-4 py-1.5 font-label uppercase text-xs tracking-wider text-parchment-base hover:bg-parchment-secondary hover:text-ink-primary font-bold cursor-pointer"
            >
              + Add Player
            </button>
          </form>

          <!-- Players List -->
          {players.length > 0 ? (
            <div class="divide-y border border-ink-primary/30 rounded bg-parchment-base">
              {players.map((player) => (
                <div class="p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-parchment-secondary/40">
                  <!-- Inline display & rename toggle -->
                  <div class="flex-1 font-serif text-base font-bold text-ink-primary flex items-center gap-2">
                    <span id={`name-display-${player.id}`}>{player.name}</span>
                    <button
                      type="button"
                      onclick={`document.getElementById('rename-form-${player.id}').classList.toggle('hidden'); document.getElementById('name-display-${player.id}').classList.toggle('hidden');`}
                      class="text-xs font-label uppercase tracking-wider text-ink-primary/60 hover:text-ink-primary underline ml-2 font-normal cursor-pointer"
                    >
                      Edit
                    </button>
                    <!-- Hidden Rename Form -->
                    <form
                      id={`rename-form-${player.id}`}
                      method="POST"
                      action={actions.renamePlayer}
                      class="hidden flex items-center gap-2"
                    >
                      <input type="hidden" name="playerId" value={player.id} />
                      <input
                        type="text"
                        name="name"
                        defaultValue={player.name}
                        required
                        class="underline-input px-2 py-0.5 text-sm font-serif"
                      />
                      <button
                        type="submit"
                        class="btn-frame border border-ink-primary bg-ink-primary text-parchment-base px-2 py-0.5 text-xs font-label uppercase tracking-wider"
                      >
                        Save
                      </button>
                      <button
                        type="button"
                        onclick={`document.getElementById('rename-form-${player.id}').classList.add('hidden'); document.getElementById('name-display-${player.id}').classList.remove('hidden');`}
                        class="text-xs font-label uppercase tracking-wider text-ink-primary/70"
                      >
                        Cancel
                      </button>
                    </form>
                  </div>

                  <!-- Remove Player Form -->
                  <form method="POST" action={actions.removePlayer} class="shrink-0">
                    <input type="hidden" name="playerId" value={player.id} />
                    <input type="hidden" name="confirmed" value="false" />
                    <button
                      type="submit"
                      class="btn-frame border border-ink-primary/50 text-ink-primary/80 hover:text-rust-ink hover:border-rust-ink px-2.5 py-1 text-xs font-label uppercase tracking-wider font-bold transition-colors cursor-pointer"
                    >
                      Remove
                    </button>
                  </form>
                </div>
              ))}
            </div>
          ) : (
            <p class="font-serif italic text-sm text-ink-primary/70 text-center py-4 border border-dashed border-ink-primary/30 rounded">
              No players added to the roster yet.
            </p>
          )}
        </section>

        <!-- 3. ADMINS & INVITES -->
        <section class="border-2 border-ink-primary p-6 rounded-md bg-parchment-secondary/20">
          <h2 class="font-label text-xl uppercase tracking-widest text-ink-primary border-b border-ink-primary/40 pb-2 mb-4 font-bold flex items-center gap-2">
            <Icon name="chair" class="size-6" /> <span>Group Admins & Invites</span>
          </h2>

          {removeAdminError && (
            <div class="mb-4 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
              <Icon name="spikes" class="size-5 shrink-0" /> <span>{removeAdminError}</span>
            </div>
          )}

          {createInviteError && (
            <div class="mb-4 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
              <Icon name="spikes" class="size-5 shrink-0" /> <span>{createInviteError}</span>
            </div>
          )}

          <div class="space-y-6">
            <!-- Current Admins List -->
            <div>
              <h3 class="font-label text-sm uppercase tracking-wider text-ink-primary/80 font-bold mb-2">
                Active Group Admins
              </h3>
              <div class="divide-y border border-ink-primary/30 rounded bg-parchment-base">
                {groupAdmins.map((adm) => {
                  const isSelf = adm.user_id === user.id;
                  return (
                    <div class="p-3 flex items-center justify-between gap-3">
                      <div class="font-serif text-sm text-ink-primary flex items-center gap-2">
                        <span class="font-mono text-xs text-ink-primary/80">User: {adm.user_id.slice(0, 8)}...</span>
                        {isSelf && (
                          <span class="font-label text-[10px] uppercase tracking-wider px-2 py-0.5 bg-ink-primary text-parchment-base rounded">
                            You
                          </span>
                        )}
                      </div>
                      <form method="POST" action={actions.removeAdmin}>
                        <input type="hidden" name="groupId" value={group.id} />
                        <input type="hidden" name="userId" value={adm.user_id} />
                        <button
                          type="submit"
                          class="btn-frame border border-ink-primary/50 text-ink-primary/80 hover:text-rust-ink hover:border-rust-ink px-2.5 py-1 text-xs font-label uppercase tracking-wider font-bold transition-colors cursor-pointer"
                        >
                          Remove Admin
                        </button>
                      </form>
                    </div>
                  );
                })}
              </div>
            </div>

            <!-- Pending Invites & Create Invite Link -->
            <div class="pt-4 border-t border-ink-primary/30">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
                <h3 class="font-label text-sm uppercase tracking-wider text-ink-primary/80 font-bold">
                  Pending Admin Invites ({invites.length})
                </h3>
                <form method="POST" action={actions.createInvite}>
                  <input type="hidden" name="groupId" value={group.id} />
                  <button
                    type="submit"
                    class="btn-frame border-2 border-ink-primary bg-ink-primary px-3 py-1 font-label uppercase text-xs tracking-wider text-parchment-base hover:bg-parchment-secondary hover:text-ink-primary font-bold cursor-pointer"
                  >
                    + Generate Invite Link
                  </button>
                </form>
              </div>

              {invites.length > 0 ? (
                <div class="space-y-2">
                  {invites.map((inv) => {
                    const joinUrl = `${origin}/admin/join?token=${inv.token}`;
                    const isExpired = new Date(inv.expires_at) < new Date();
                    return (
                      <div class="p-3 border border-ink-primary/30 rounded bg-parchment-base flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="overflow-hidden">
                          <div class="font-mono text-xs text-ink-primary truncate max-w-md">
                            {joinUrl}
                          </div>
                          <div class="font-serif text-[11px] text-ink-primary/70">
                            Expires: {new Date(inv.expires_at).toLocaleDateString()} {isExpired ? "(EXPIRED)" : ""}
                          </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                          <button
                            type="button"
                            onclick={`navigator.clipboard.writeText('${joinUrl}'); this.innerText='Copied!'; setTimeout(() => this.innerText='Copy Link', 2000);`}
                            class="btn-frame border border-ink-primary bg-parchment-secondary px-2.5 py-1 text-xs font-label uppercase tracking-wider font-bold hover:bg-ink-primary hover:text-parchment-base cursor-pointer"
                          >
                            Copy Link
                          </button>
                          <form method="POST" action={actions.revokeInvite}>
                            <input type="hidden" name="inviteId" value={inv.id} />
                            <button
                              type="submit"
                              class="btn-frame border border-ink-primary/40 text-ink-primary/70 hover:text-rust-ink px-2.5 py-1 text-xs font-label uppercase tracking-wider font-bold cursor-pointer"
                            >
                              Revoke
                            </button>
                          </form>
                        </div>
                      </div>
                    );
                  })}
                </div>
              ) : (
                <p class="font-serif italic text-sm text-ink-primary/70 text-center py-3 border border-dashed border-ink-primary/30 rounded">
                  No pending invite links active.
                </p>
              )}
            </div>
          </div>
        </section>

        <!-- 4. SHARE & PUBLIC LINK -->
        <section class="border-2 border-ink-primary p-6 rounded-md bg-parchment-secondary/20">
          <h2 class="font-label text-xl uppercase tracking-widest text-ink-primary border-b border-ink-primary/40 pb-2 mb-4 font-bold flex items-center gap-2">
            <Icon name="cave" class="size-6" /> <span>Public Campaign Ledger Link</span>
          </h2>
          <p class="font-serif text-sm text-ink-primary/80 mb-3">
            Share this link with your players so they can view campaign sessions and submit availability polls.
          </p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
            <input
              type="text"
              readonly
              value={publicGroupUrl}
              class="underline-input flex-1 px-3 py-2 font-mono text-sm bg-parchment-base/60"
            />
            <button
              type="button"
              onclick={`navigator.clipboard.writeText('${publicGroupUrl}'); this.innerText='Copied!'; setTimeout(() => this.innerText='Copy Public URL', 2000);`}
              class="btn-frame border-2 border-ink-primary bg-ink-primary px-4 py-2 font-label uppercase tracking-wider text-xs text-parchment-base hover:bg-parchment-secondary hover:text-ink-primary font-bold cursor-pointer shrink-0"
            >
              Copy Public URL
            </button>
          </div>
        </section>

        <!-- 5. CAMPAIGN SESSIONS -->
        <section class="border-2 border-ink-primary p-6 rounded-md bg-parchment-secondary/20">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-ink-primary/40 pb-3 mb-6">
            <div>
              <h2 class="font-label text-xl uppercase tracking-widest text-ink-primary font-bold m-0 flex items-center gap-2">
                <Icon name="swords" class="size-6" /> <span>Campaign Session Polls ({sessions.length})</span>
              </h2>
              <p class="font-serif text-sm text-ink-primary/80 mt-1">
                Schedule D&D sessions, set candidate days, and manage lifecycle.
              </p>
            </div>
            <a
              href={`/admin/${canonicalSlug}/create`}
              class="btn-frame border-2 border-ink-primary bg-ink-primary px-4 py-2 font-label uppercase tracking-wider text-xs text-parchment-base hover:bg-parchment-secondary hover:text-ink-primary font-bold shrink-0 text-center cursor-pointer"
            >
              + Create Session Poll &rarr;
            </a>
          </div>

          {confirmSessionError && (
            <div class="mb-4 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
              <Icon name="spikes" class="size-5 shrink-0" /> <span>{confirmSessionError}</span>
            </div>
          )}

          {closeSessionError && (
            <div class="mb-4 p-3 border-2 border-rust-ink bg-rust-paper/40 text-rust-ink text-sm font-serif font-bold rounded flex items-center gap-2">
              <Icon name="spikes" class="size-5 shrink-0" /> <span>{closeSessionError}</span>
            </div>
          )}

          {sessions.length > 0 ? (
            <div class="space-y-4">
              {sessions.map((sess) => {
                const tallies = allTallies[sess.id] || [];
                const votedCount = voteCounts[sess.id] || 0;
                return (
                  <SessionCard
                    session={sess}
                    groupSlug={canonicalSlug}
                    viabilityThreshold={group.viability_threshold}
                    tallies={tallies}
                    totalPlayersCount={players.length}
                    votedCount={votedCount}
                    isAdmin={true}
                  />
                );
              })}
            </div>
          ) : (
            <div class="border-2 border-dashed border-ink-primary/40 p-8 text-center rounded-md bg-parchment-base flex flex-col items-center">
              <Icon name="dice" class="size-12 text-ink-primary mb-2" />
