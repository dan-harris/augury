---
import Icon from "../../components/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import { createServerClient } from "../../lib/supabase/server";

export const prerender = false;

const url = new URL(Astro.request.url);
const code = url.searchParams.get("code");
const tokenHash = url.searchParams.get("token_hash");
const type = url.searchParams.get("type");
const rawNext = url.searchParams.get("next");

let next = "/admin";
if (rawNext && rawNext.startsWith("/") && !rawNext.startsWith("//")) {
  try {
    const parsed = new URL(rawNext, url.origin);
    if (parsed.origin === url.origin) {
      next = parsed.pathname + parsed.search + parsed.hash;
    }
  } catch {
    next = "/admin";
  }
}

let errorMessage: string | null = null;
const supabase = createServerClient(Astro.cookies, Astro.request.headers);

if (code) {
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (!error) {
    return Astro.redirect(next);
  }
  errorMessage = error.message;
} else if (tokenHash && type) {
  const { error } = await supabase.auth.verifyOtp({
    token_hash: tokenHash,
    type: type as any,
  });
  if (!error) {
    return Astro.redirect(next);
  }
  errorMessage = error.message;
} else {
  errorMessage = "No code or token_hash was provided in the confirmation link.";
}
---

<Layout title="Verification Failed — Augury Ledger">
  <main class="max-w-[700px] mx-auto">
    <div class="border-page border-2 border-ink-primary p-6 sm:p-12 relative text-center">
      <div class="border-2 border-rust-ink bg-rust-paper/20 p-8 rounded-md relative">
        <label class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-parchment-base px-3 font-label font-bold uppercase text-xs tracking-widest text-rust-ink">
          Verification Warning
        </label>

        <div class="mb-2 flex justify-center"><Icon name="spikes" class="size-16 text-rust-ink" /></div>

        <h1 class="font-gothic text-4xl sm:text-5xl text-rust-ink m-0 leading-tight">
          Sign In Verification Failed
        </h1>

        <p class="font-serif text-lg text-rust-ink font-semibold mt-3 mb-6">
          {errorMessage}
        </p>

        <div class="border border-rust-ink/40 bg-parchment-base p-4 text-left font-serif text-sm leading-relaxed text-ink-primary rounded">
          <p class="font-label font-bold uppercase text-xs tracking-wider text-rust-ink mb-1 flex items-center gap-1.5">
            <Icon name="info" class="size-4 text-rust-ink" /> <span>Important PKCE Note:</span>
          </p>
          <p>
            Magic link sign-in relies on browser-stored PKCE security code verifiers. The emailed link <strong>must be opened in the same browser and session</strong> where you requested it. Opening the link in another browser or incognito tab will fail.
          </p>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="/admin"
            class="border-button border-2 border-ink-primary bg-ink-primary px-6 py-2.5 font-label uppercase text-sm tracking-wider text-parchment-base hover:bg-parchment-secondary hover:text-ink-primary"
          >
            Request New Magic Link
          </a>
          <a
            href="/"
            class="border-button border-2 border-ink-primary bg-transparent px-6 py-2.5 font-label uppercase text-sm tracking-wider text-ink-primary hover:bg-ink-primary hover:text-parchment-base"
          >
            Return to Main Ledger
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
