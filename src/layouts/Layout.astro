---
import "../styles/global.css";
import { AuthMenu } from "../components/islands/AuthMenu";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Augury — D&D Session Scheduler & Character Ledger",
  description = "Augury D&D session scheduler and predictive gaming engine.",
} = Astro.props;

const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen text-ink-primary font-serif leading-relaxed flex flex-col selection:bg-rust-paper selection:text-ink-primary"
  >
    <!-- SVG Print Texture Filter -->
    <svg width="0" height="0" class="absolute -z-10" aria-hidden="true">
      <filter id="print-texture" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.6"
          numOctaves="1"
          result="noise"></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="noise"
          scale="1.0"
          xChannelSelector="R"
          yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>

    <header class="sticky top-0 z-50">
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-8"
      >
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center gap-3 group focus:outline-none">
            <img
              src="/logo.png"
              alt="Augury Logo"
              class="h-10 mix-blend-multiply transition-transform group-hover:scale-105"
              onerror="this.style.display='none'"
            />
            <div class="flex flex-col">
              <span
                class="font-gothic text-3xl sm:text-4xl text-ink-primary leading-none group-hover:opacity-80 transition-opacity"
              >
                Augury
              </span>
            </div>
          </a>

          <nav
            class="hidden md:flex items-center gap-4 text-xs font-label uppercase tracking-widest border-l-2 border-ink-primary/30 pl-6"
          >
            <a
              href="/"
              class="hover:underline underline-offset-4 decoration-ink-primary"
              >Ledger</a
            >
            <a
              href="/admin"
              class="hover:underline underline-offset-4 decoration-ink-primary"
              >Admin</a
            >
          </nav>
        </div>

        <AuthMenu client:load userEmail={user?.email} />
      </div>
    </header>

    <div class="flex-1 py-8 px-4 sm:px-8">
      <slot />
    </div>

    <footer class="py-6 text-center text-xs font-serif text-ink-primary/80">
      <div
        class="mx-auto max-w-6xl px-4 flex flex-col sm:flex-row justify-end items-center gap-2"
      >
        <div class="italic text-sm">
          Anno Domini {new Date().getFullYear()} &bull; <a
            href="https://danharris.dev">danharris.dev</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
